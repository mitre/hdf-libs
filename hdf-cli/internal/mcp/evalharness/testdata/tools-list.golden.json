            "properties": {
              "handle": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "name": "hdf_open",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "docType": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "notice": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object"
          },
          "valid": {
            "type": "boolean"
          },
          "validationErrors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                }
              },
              "required": [
                "line",
                "description"
              ],
              "type": "object"
            },
            "type": [
              "null",
