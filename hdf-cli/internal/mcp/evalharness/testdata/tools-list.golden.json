{
  "cacheScope": "public",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Compute aggregate percent compliance and status/severity rollups (by effective status: impact-0 is Not Applicable and excluded from the denominator, overrides honored) for an HDF results document, with an optional grouped breakdown and threshold verdict. counts is aggregate — for per-requirement status use hdf_query. counts uses SAF threshold-file keys: skipped = notReviewed, no_impact = notApplicable. The agentOverrides block is the detective surface: agent-attributed override count and the compliance delta they account for.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "groupBy": {
            "description": "baseline | severity | nistFamily",
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "description": "document as {path} or {handle}",
            "properties": {
              "handle": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "threshold": {
            "additionalProperties": false,
            "description": "threshold spec: {path} to a YAML/JSON file, or {inline} object",
            "properties": {
              "inline": {
                "additionalProperties": true,
                "description": "inline threshold spec (compliance/passed/failed/... bounds)",
                "type": "object"
              },
              "path": {
                "description": "path to a YAML/JSON threshold file under HDF_MCP_ROOT",
                "type": "string"
              }
            },
            "type": [
              "null",
              "object"
            ]
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "name": "hdf_compliance",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "agentOverrides": {
            "additionalProperties": false,
            "properties": {
              "complianceDelta": {
                "type": "number"
              },
              "count": {
                "type": "integer"
              }
            },
            "required": [
              "count",
              "complianceDelta"
            ],
            "type": "object"
          },
          "compliance": {
            "type": "number"
          },
          "counts": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "type": "object"
          },
          "docType": {
            "type": "string"
          },
          "groupBy": {
            "type": "string"
          },
          "groups": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "compliance": {
                  "type": "number"
                },
                "counts": {
                  "additionalProperties": {
                    "additionalProperties": {
                      "type": "integer"
                    },
                    "type": "object"
                  },
                  "type": "object"
                },
                "group": {
                  "type": "string"
                }
              },
              "required": [
                "group",
                "compliance",
                "counts"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "handle": {
            "type": "string"
          },
          "notice": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          },
          "thresholdVerdict": {
            "additionalProperties": false,
            "properties": {
              "failures": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "pass": {
                "type": "boolean"
              }
            },
            "required": [
              "pass",
              "failures"
            ],
            "type": [
              "null",
              "object"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "handle",
          "docType",
          "schemaVersion",
          "compliance",
          "counts",
          "agentOverrides"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Compare two HDF documents: temporal (results across time) or system-drift (system documents). Returns a summary and a bounded change list, and — when output is given — writes a schema-valid hdf-comparison document. Diffing is delegated to the shared hdf-diff engine.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "additionalProperties": false,
            "description": "the 'before' document as {path} or {handle}",
            "properties": {
              "handle": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "mode": {
            "description": "temporal (results across time, default) or system-drift (system docs)",
            "type": "string"
          },
          "output": {
            "description": "path under HDF_MCP_ROOT to write the hdf-comparison document",
            "type": "string"
          },
          "page": {
            "description": "0-based page when the change list is truncated",
            "type": "integer"
          },
          "to": {
            "additionalProperties": false,
            "description": "the 'after' document as {path} or {handle}",
            "properties": {
              "handle": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "verbosity": {
            "description": "concise (default) or full",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "name": "hdf_diff",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "fromHandle": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "nextPage": {
            "type": "integer"
          },
          "notice": {
            "type": "string"
          },
          "outputPath": {
            "type": "string"
          },
          "returned": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "summary": {
            "additionalProperties": false,
            "properties": {
              "absent": {
                "type": "integer"
              },
              "fixed": {
                "type": "integer"
              },
              "matchedCount": {
                "type": "integer"
              },
              "new": {
                "type": "integer"
              },
              "regressed": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "unchanged": {
                "type": "integer"
              },
              "unmatchedNewCount": {
                "type": "integer"
              },
              "unmatchedOldCount": {
                "type": "integer"
              },
              "updated": {
                "type": "integer"
              }
            },
            "required": [
              "fixed",
              "regressed",
              "new",
              "absent",
              "unchanged",
              "updated",
              "total",
              "matchedCount",
              "unmatchedOldCount",
              "unmatchedNewCount"
            ],
            "type": "object"
          },
          "toHandle": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "fromHandle",
          "toHandle",
          "mode",
          "summary",
          "changes",
          "total",
          "returned"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Inspect an HDF document's structure and metadata for any of the eight document types (counts, inventories, envelopes) — never a requirement collection. To list requirements, use hdf_query.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "description": "0-based page when truncated",
            "type": "integer"
          },
          "section": {
            "description": "one structural section (validity depends on doc type)",
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "description": "document as {path} or {handle}",
            "properties": {
              "handle": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "verbosity": {
            "description": "concise (default) or full",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "name": "hdf_inspect",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "docType": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "nextPage": {
            "type": "integer"
          },
          "notice": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "structure": {
            "additionalProperties": true,
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "valid": {
            "type": "boolean"
          },
          "validationErrors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                }
              },
              "required": [
                "line",
                "description"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "required": [
          "handle",
          "docType",
          "schemaVersion",
          "valid"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
