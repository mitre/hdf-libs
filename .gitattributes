# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Enforce LF line endings for all test fixtures and generated output so that
# checksums, snapshot comparisons, and diff-based assertions are identical on
# Windows (core.autocrlf=true) and *nix.  This is the industry-standard
# approach (Prettier, Hugo, ESLint, etc.).
hdf-converters/**/fixtures/** eol=lf
# Vendored upstream schemas are byte-exact artifacts whose SHA-256 is recorded
# in provenance.json, so they must check out verbatim on every platform.
# -text, not eol=lf: some upstreams ship CRLF (NIST's cpe-naming_2.3.xsd does),
# and forcing LF would make our copy differ from the bytes we recorded a hash
# for -- the same corruption as a CRLF checkout, in the other direction.
hdf-converters/**/schemas/** -text
# Schemas vendored beside an importer's fixtures (sarif-schema-*.json, bom-*.schema.json,
# *-report-format-*.json, *.xsd, ...) are the same kind of artifact and get the same rule;
# the fixtures eol=lf line above would otherwise rewrite the bytes their hash was taken from.
hdf-converters/**/fixtures/*.xsd -text
hdf-converters/**/fixtures/*schema*.json -text
hdf-converters/**/fixtures/*-report-format-*.json -text
# Embedded report assets are byte-exact artifacts too: Go embeds them into the
# goldens, the vendored stylesheet's sha256 is recorded in provenance.txt, and
# the TypeScript module is generated from the same bytes, so a CRLF checkout
# breaks all three at once.
hdf-converters/**/go/assets/** -text
hdf-converters/converters/hdf-to-html/typescript/assets.ts eol=lf
hdf-cli/cmd/hdf/cmd/testdata/**/*.json eol=lf
hdf-cli/internal/mcp/**/testdata/**/*.json eol=lf
hdf-cli/internal/mcp/**/testdata/**/*.jsonl eol=lf
hdf-schema/test/**/*.json eol=lf
hdf-generators/test/**/*.json eol=lf
hdf-validators/test/**/*.json eol=lf
site/data/converters.json eol=lf
# The OpenAPI tooling baseline is byte-compared against freshly serialised output, both by
# scripts/openapi-matrix.mjs and by its test, so a CRLF checkout would fail the comparison.
hdf-openapi/test/baseline/*.json eol=lf

# Test fixtures are stored as regular git objects (text XML/JSON compresses
# well in packfiles). Large full-scan fixtures that exceed ~1 MB should not
# be committed — use trimmed or minimal versions for unit tests, and test
# against full real data locally during converter development.

# quicktype-generated Go types (regenerated from hdf-schema/src/schemas via
# `pnpm build`; never hand-edited). Marked generated so GitHub collapses it in
# diffs and code-review tools (Copilot) exclude it from their review budget.
hdf-schema/dist/go/hdf.go linguist-generated=true
