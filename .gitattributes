# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Enforce LF line endings for all test fixtures and generated output so that
# checksums, snapshot comparisons, and diff-based assertions are identical on
# Windows (core.autocrlf=true) and *nix.  This is the industry-standard
# approach (Prettier, Hugo, ESLint, etc.).
hdf-converters/**/fixtures/** eol=lf
hdf-cli/cmd/hdf/cmd/testdata/**/*.json eol=lf
hdf-schema/test/**/*.json eol=lf
hdf-generators/test/**/*.json eol=lf
hdf-validators/test/**/*.json eol=lf

# Test fixtures are stored as regular git objects (text XML/JSON compresses
# well in packfiles). Large full-scan fixtures that exceed ~1 MB should not
# be committed — use trimmed or minimal versions for unit tests, and test
# against full real data locally during converter development.

# quicktype-generated Go types (regenerated from hdf-schema/src/schemas via
# `pnpm build`; never hand-edited). Marked generated so GitHub collapses it in
# diffs and code-review tools (Copilot) exclude it from their review budget.
hdf-schema/dist/go/hdf.go linguist-generated=true
