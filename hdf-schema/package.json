{
  "name": "@mitre/hdf-schema",
  "version": "0.1.0",
  "description": "JSON schemas and multi-language type definitions for Heimdall Data Format (HDF)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas/*": "./src/schemas/*"
  },
  "files": [
    "dist",
    "src/schemas"
  ],
  "scripts": {
    "build": "pnpm clean && tsc && tsx src/bundle-schemas.ts && tsx src/generate-types.ts",
    "build:schemas": "tsx src/bundle-schemas.ts",
    "build:types": "tsx src/generate-types.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git",
    "directory": "hdf-schema"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.1.2",
    "@types/node": "^24.10.1",
    "quicktype-core": "^23.0.0",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hdf",
    "heimdall",
    "security",
    "json-schema",
    "inspec",
    "stig",
    "compliance"
  ]
}
