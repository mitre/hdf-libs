{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mitre.github.io/hdf-libs/schemas/hdf-comparison/v3.7.0",
  "type": "object",
  "$comment": "Examples, in order: 1) a temporal comparison of two runs of the same scan, showing one fixed, one regressed and one new requirement. Produced by `hdf diff` over hdf-diff/test/fixtures/scan-before.json and scan-after.json with whole requirements dropped from the inputs, so `summary` is computed by the engine and matches the diffs it reports. The engine also writes a `baseline` key on each diff that this definition does not declare; it is omitted here, so regenerating this example needs that key stripped until the schema and the engine agree.",
  "unevaluatedProperties": false,
  "required": [
    "formatVersion",
    "comparisonMode",
    "sources",
    "summary",
    "requirementDiffs"
  ],
  "properties": {
    "externalReferences": {
      "type": "array",
      "items": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/common/v3.7.0#/$defs/External_Reference"
      },
      "description": "Optional references to external artifacts relevant to this comparison (CTI/STIX, advisories, or any URI-addressable artifact). Inert context; see External_Reference."
    },
    "formatVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version for this comparison format."
    },
    "comparisonMode": {
      "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Comparison_Mode",
      "description": "The mode of comparison being performed."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this comparison was performed."
    },
    "generator": {
      "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/extensions/v3.7.0#/$defs/Generator",
      "description": "Information about the tool that generated this comparison."
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Source"
      },
      "description": "The source documents being compared. At least two sources are required."
    },
    "matching": {
      "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Matching_Config",
      "description": "Configuration for how requirements were matched across sources."
    },
    "summary": {
      "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Comparison_Summary",
      "description": "Summary statistics for the overall comparison."
    },
    "baselineDiffs": {
      "type": "array",
      "items": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Baseline_Diff"
      },
      "description": "Comparison of baselines between sources."
    },
    "requirementDiffs": {
      "type": "array",
      "items": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Requirement_Diff"
      },
      "description": "Detailed comparison of individual requirements between sources."
    },
    "componentDiffs": {
      "type": "array",
      "items": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Component_Diff"
      },
      "description": "Comparison of components between two system documents. Used in systemDrift mode. A component's BOM changes surface as a field change on its boms[] here."
    },
    "packageDiffs": {
      "type": "array",
      "items": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Package_Diff"
      },
      "description": "RESERVED \u2014 not emitted by the current systemDrift comparison. systemDrift now reports a component's BOM changes as a field change on its boms[] (see componentDiffs), and standalone SBOM package diffing is a separate `hdf diff <sbom> <sbom>` output shape. This field is retained for a future normalized package-level diff; consumers must not expect it from today's systemDrift output."
    },
    "systemRef": {
      "type": "string",
      "format": "uri-reference",
      "description": "URI identifying the system being compared in systemDrift mode."
    },
    "drift": {
      "type": "array",
      "items": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Requirement_Diff"
      },
      "description": "External/metadata changes separate from status changes (Terraform pattern)."
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/comparison/v3.7.0#/$defs/Annotation"
      },
      "description": "Map of annotation IDs to annotation objects, providing context or action items for requirement diffs."
    },
    "integrity": {
      "$ref": "https://mitre.github.io/hdf-libs/schemas/primitives/extensions/v3.7.0#/$defs/Integrity",
      "description": "Cryptographic integrity information for verifying this comparison document."
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved for tool-specific data not defined in the HDF standard."
    }
  },
  "examples": [
    {
      "formatVersion": "1.0.0",
      "comparisonMode": "temporal",
      "sources": [
        {
          "role": "old",
          "label": "trim-before.json"
        },
        {
          "role": "new",
          "label": "trim-after.json"
        }
      ],
      "summary": {
        "fixed": 1,
        "regressed": 1,
        "new": 1,
        "absent": 0,
        "unchanged": 0,
        "updated": 0,
        "total": 3,
        "matchedCount": 2,
        "unmatchedOldCount": 0,
        "unmatchedNewCount": 1
      },
      "requirementDiffs": [
        {
          "id": "SV-001",
          "state": "fixed",
          "changeReasons": [
            "resultChanged"
          ],
          "before": {
            "descriptions": [
              {
                "data": "The system must disable root SSH login",
                "label": "default"
              }
            ],
            "id": "SV-001",
            "impact": 0.7,
            "results": [
              {
                "codeDesc": "SSH config PermitRootLogin should eq 'no'",
                "message": "expected 'yes' to eq 'no'",
                "runTime": 0.1,
                "startTime": "2024-01-01T00:00:00Z",
                "status": "failed"
              }
            ],
            "sourceLocation": {
              "line": 1,
              "ref": "controls/stig.rb"
            },
            "tags": {
              "cci": [
                "CCI-000366"
              ],
              "nist": [
                "AC-6"
              ],
              "severity": "high"
            },
            "title": "Ensure SSH root login is disabled"
          },
          "after": {
            "descriptions": [
              {
                "data": "The system must disable root SSH login",
                "label": "default"
              }
            ],
            "id": "SV-001",
            "impact": 0.7,
            "results": [
              {
                "codeDesc": "SSH config PermitRootLogin should eq 'no'",
                "runTime": 0.1,
                "startTime": "2024-02-01T00:00:00Z",
                "status": "passed"
              }
            ],
            "sourceLocation": {
              "line": 1,
              "ref": "controls/stig.rb"
            },
            "tags": {
              "cci": [
                "CCI-000366"
              ],
              "nist": [
                "AC-6"
              ],
              "severity": "high"
            },
            "title": "Ensure SSH root login is disabled"
          },
          "fieldChanges": [],
          "oldEffectiveStatus": "failed",
          "newEffectiveStatus": "passed",
          "title": "Ensure SSH root login is disabled"
        },
        {
          "id": "SV-003",
          "state": "regressed",
          "changeReasons": [
            "resultChanged"
          ],
          "before": {
            "descriptions": [
              {
                "data": "The audit subsystem must be active",
                "label": "default"
              }
            ],
            "id": "SV-003",
            "impact": 0.7,
            "results": [
              {
                "codeDesc": "auditd service should be enabled",
                "runTime": 0.08,
                "startTime": "2024-01-01T00:00:02Z",
                "status": "passed"
              }
            ],
            "sourceLocation": {
              "line": 40,
              "ref": "controls/stig.rb"
            },
            "tags": {
              "cci": [
                "CCI-000130"
              ],
              "nist": [
                "AU-3"
              ],
              "severity": "high"
            },
            "title": "Ensure audit logging is enabled"
          },
          "after": {
            "descriptions": [
              {
                "data": "The audit subsystem must be active",
                "label": "default"
              }
            ],
            "id": "SV-003",
            "impact": 0.7,
            "results": [
              {
                "codeDesc": "auditd service should be enabled",
                "message": "expected service to be enabled, got disabled",
                "runTime": 0.07,
                "startTime": "2024-02-01T00:00:02Z",
                "status": "failed"
              }
            ],
            "sourceLocation": {
              "line": 40,
              "ref": "controls/stig.rb"
            },
            "tags": {
              "cci": [
                "CCI-000130"
              ],
              "nist": [
                "AU-3"
              ],
              "severity": "high"
            },
            "title": "Ensure audit logging is enabled"
          },
          "fieldChanges": [],
          "oldEffectiveStatus": "passed",
          "newEffectiveStatus": "failed",
          "title": "Ensure audit logging is enabled"
        },
        {
          "id": "SV-006",
          "state": "new",
          "changeReasons": [],
          "before": null,
          "after": {
            "descriptions": [
              {
                "data": "SELinux must be in enforcing mode",
                "label": "default"
              }
            ],
            "id": "SV-006",
            "impact": 0.7,
            "results": [
              {
                "codeDesc": "getenforce should return Enforcing",
                "runTime": 0.01,
                "startTime": "2024-02-01T00:00:05Z",
                "status": "passed"
              }
            ],
            "sourceLocation": {
              "line": 100,
              "ref": "controls/stig.rb"
            },
            "tags": {
              "cci": [
                "CCI-002165"
              ],
              "nist": [
                "AC-3 (4)"
              ],
              "severity": "high"
            },
            "title": "Ensure SELinux is enforcing"
          },
          "fieldChanges": [],
          "newEffectiveStatus": "passed",
          "title": "Ensure SELinux is enforcing"
        }
      ],
      "baselineDiffs": [
        {
          "name": "rhel9-stig-baseline",
          "oldVersion": "1.0.0",
          "newVersion": "1.1.0",
          "state": "updated"
        }
      ]
    }
  ],
  "description": "Structured comparison between two or more HDF security assessment documents. Supports temporal, baseline, fleet, and multi-source comparison modes.",
  "title": "HDF Comparison"
}
