metadata": "{}", "mol_type": "", "notes": "", "owner": "", "payload": "", "pinned": 0, "priority": 0, "rig": "", "role_bead": "", "role_type": "", "sender": "", "source_repo": "", "source_system": "", "spec_id": "", "status": "closed", "target": "", "timeout_ns": 0, "title": "Research SAF CLI / heimdall2 aws-config converter design for input format and field mapping", "updated_at": "2026-02-19 00:00:00", "waiters": "", "wisp_type": "", "work_type": ""}
