{
  "name": "@mitre/hdf-utilities",
  "version": "0.1.0",
  "description": "Utility functions for HDF libraries (JSON parsing, validation helpers)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc",
    "clean": "rm -rf dist",
    "test": "pnpm run test:ts",
    "test:ts": "vitest run",
    "test:go": "echo 'No Go tests in hdf-utilities'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git",
    "directory": "hdf-utilities"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "dependencies": {
    "fast-xml-parser": "^5.3.3",
    "papaparse": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hdf",
    "heimdall",
    "utilities",
    "json",
    "parsing"
  ],
  "devDependencies": {
    "@types/papaparse": "^5.5.2"
  }
}
