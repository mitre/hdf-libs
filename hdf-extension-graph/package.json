{
  "name": "@mitre/hdf-extension-graph",
  "version": "3.1.0",
  "description": "Bidirectional extension graph processing for HDF profile/baseline hierarchies",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "test": "pnpm run test:ts",
    "test:ts": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git",
    "directory": "hdf-extension-graph"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "dependencies": {
    "@mitre/hdf-schema": "workspace:^"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "hdf",
    "heimdall",
    "extension",
    "overlay",
    "profile",
    "graph"
  ]
}
