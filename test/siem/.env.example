# The runner reads these opt-ins from the process environment; it generates passwords.
RYUK_CONTAINER_IMAGE=testcontainers/ryuk:0.14.0@sha256:7c1a8a9a47c780ed0f983770a662f80deb115d95cce3e2daa3d12115b8cd28f0
# Set to yes only after accepting the current Splunk General Terms for this test.
HDF_SIEM_ACCEPT_SPLUNK_TERMS=
# Required when using the AMD64-only Splunk Enterprise image on an ARM64 runtime.
HDF_SIEM_ALLOW_AMD64_EMULATION=
