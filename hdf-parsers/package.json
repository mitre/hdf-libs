{
  "name": "@mitre/hdf-parsers",
  "version": "0.1.0",
  "description": "Parse and load HDF documents with validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc",
    "clean": "rimraf dist",
    "test": "pnpm run test:ts && pnpm run test:go",
    "test:ts": "vitest run",
    "test:go": "cd go && go test ./...",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint typescript",
    "lint:fix": "eslint typescript --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git",
    "directory": "hdf-parsers"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "dependencies": {
    "@mitre/hdf-schema": "workspace:*",
    "@mitre/hdf-validators": "workspace:*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hdf",
    "heimdall",
    "parser",
    "json"
  ],
  "devDependencies": {
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1"
  }
}
