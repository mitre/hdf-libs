{
  "name": "@mitre/hdf-mappings",
  "version": "3.9.0-next.46041087453.1",
  "description": "CCI/NIST/CIS/CMMC security framework mappings for HDF",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "mappings:awsconfig": "node scripts/generate-awsconfig-mappings.mjs",
    "mappings:awsconfig:check": "node scripts/generate-awsconfig-mappings.mjs --check",
    "mappings:cci": "node scripts/generate-cci-mappings.mjs",
    "mappings:cci:check": "node scripts/generate-cci-mappings.mjs --check",
    "mappings:crosswalk": "node scripts/generate-nist-crosswalk.mjs",
    "mappings:crosswalk:check": "node scripts/generate-nist-crosswalk.mjs --check",
    "mappings:descriptions": "node scripts/generate-nist-descriptions.mjs",
    "mappings:descriptions:check": "node scripts/generate-nist-descriptions.mjs --check",
    "mappings:hipcheck": "node scripts/generate-hipcheck-mappings.mjs",
    "mappings:hipcheck:check": "node scripts/generate-hipcheck-mappings.mjs --check",
    "test": "pnpm run test:ts",
    "test:ts": "vitest run",
    "test:go": "cd go && go test ./...",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.lib.json --noEmit",
    "type-check:tests": "tsc -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git",
    "directory": "hdf-mappings"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "devDependencies": {
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "hdf",
    "heimdall",
    "cci",
    "nist",
    "mappings",
    "security",
    "compliance"
  ]
}
