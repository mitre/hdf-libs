{
  "name": "@mitre/hdf-mappings",
  "version": "0.1.0",
  "description": "CCI/NIST/CIS/CMMC security framework mappings for HDF",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc && pnpm copy-data",
    "clean": "rm -rf dist",
    "copy-data": "cp -r src/data dist/data",
    "test": "pnpm run test:ts",
    "test:ts": "vitest run",
    "test:go": "echo 'No Go tests in hdf-mappings'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git",
    "directory": "hdf-mappings"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "hdf",
    "heimdall",
    "cci",
    "nist",
    "mappings",
    "security",
    "compliance"
  ]
}
