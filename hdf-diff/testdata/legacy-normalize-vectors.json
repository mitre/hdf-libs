        "refs": [
          {}
        ],
        "want": []
      },
      {
        "name": "an empty ref string carries nothing",
        "refs": [
          {
            "ref": ""
          }
        ],
        "want": []
      },
      {
        "name": "an empty ref array carries nothing",
        "refs": [
          {
            "ref": []
          }
        ],
        "want": []
      },
      {
        "name": "a ref array holding no objects carries nothing",
