      },
      {
        "name": "a url-only ref is kept",
        "refs": [
          {
            "url": "https://example.test/a"
          }
        ],
        "want": [
          {
            "url": "https://example.test/a"
          }
        ]
      },
      {
        "name": "a uri-only ref is kept",
        "refs": [
          {
            "uri": "urn:example:x"
          }
        ],
        "want": [
          {
            "uri": "urn:example:x"
          }
        ]
      },
      {
        "name": "an empty url and uri carry nothing",
        "refs": [
          {
            "url": "",
            "uri": ""
          }
        ],
        "want": []
      },
      {
        "name": "ref, url and uri together are all kept",
        "refs": [
          {
            "ref": "r",
            "url": "https://example.test/u",
            "uri": "urn:example:u"
          }
        ],
        "want": [
          {
            "ref": "r",
            "url": "https://example.test/u",
            "uri": "urn:example:u"
          }
        ]
      },
      {
        "name": "the empty entries are dropped and the rest kept",
        "refs": [
          {
            "ref": []
          },
          {
            "ref": "keep"
          },
          {}
