  <Snippet id="7E298BB81D9A531150E4FCB87E44E827#webgoat-lessons/sql-injection/src/main/java/org/owasp/webgoat/sql_injection/advanced/SqlInjectionChallengeLogin.java:44:59">
    <File>webgoat-lessons/sql-injection/src/main/java/org/owasp/webgoat/sql_injection/advanced/SqlInjectionChallengeLogin.java</File>
    <StartLine>41</StartLine>
    <EndLine>60</EndLine>
    <Text><![CDATA[
  @PostMapping("/SqlInjectionAdvanced/challenge_Login")
  @ResponseBody
  public AttackResult login(@RequestParam String username_login, @RequestParam String password_login) throws Exception {
    Connection connection = DatabaseUtilities.getConnection(webSession);
    SqlInjectionChallenge.checkDatabase(connection);

    PreparedStatement statement = connection.prepareStatement("select password from " + SqlInjectionChallenge.USERS_TABLE_NAME + " where userid = ? and password = ?");
    statement.setString(1, username_login);
    statement.setString(2, password_login);
    ResultSet resultSet = statement.executeQuery();

    if (resultSet.next()) {
        return ("tom".equals(username_login)) ? trackProgress(success().build())
        		: success().feedback("ResultsButNotTom").build();
    } else {
      return failed().feedback("NoResultsMatched").build();
    }
  }
}
]]></Text>
  </Snippet>
