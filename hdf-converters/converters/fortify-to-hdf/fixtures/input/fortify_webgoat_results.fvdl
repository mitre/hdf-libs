  <Snippet id="4C02CAD9898062AF15477830B5B19E6D#webgoat-container/src/main/java/org/owasp/webgoat/plugins/CourseConfiguration.java:78:90">
    <File>webgoat-container/src/main/java/org/owasp/webgoat/plugins/CourseConfiguration.java</File>
