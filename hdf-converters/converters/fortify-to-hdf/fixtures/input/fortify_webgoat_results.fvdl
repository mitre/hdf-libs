    <StartLine>76</StartLine>
    <EndLine>82</EndLine>
    <Text><![CDATA[    public ModelAndView importFile(@RequestParam("file") MultipartFile myFile) {
        WebGoatUser user = (WebGoatUser) SecurityContextHolder.getContext().getAuthentication().getPrincipal();
        File destinationDir = new File(fileLocation, user.getUsername());
        destinationDir.mkdirs();
        myFile.transferTo(new File(destinationDir, myFile.getOriginalFilename()));
        log.debug("File saved to {}", new File(destinationDir, myFile.getOriginalFilename()));
        Files.touch(new File(destinationDir, user.getUsername() + "_changed"));
]]></Text>
