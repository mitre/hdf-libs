ts/jinja/commit/48b0687e05a5466a91cd5812d604fa37ad0943b4","https://lists.debian.org/debian-lts-announce/2025/04/msg00022.html"],"description":"Jinja has a sandbox breakout through indirect reference to format method","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","metrics":{"baseScore":7.8,"exploitabilityScore":1.9,"impactScore":5.9},"vendorMetadata":{}},{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","metrics":{"baseScore":5.4},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-56326","epss":0.00521,"percentile":0.43191,"date":"2026-09-19"}],"cwes":[{"cve":"CVE-2024-56326","cwe":"CWE-693","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2024-56326","cwe":"CWE-1336","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["3.1.5"],"state":"fixed","available":[{"version":"3.1.5","date":"2024-12-24","kind":"first-observed"}]},"advisories":[],"risk":0.30218},"relatedVulnerabilities":[{"id":"CVE-2024-56326","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2024-56326","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/pallets/jinja/commit/48b0687e05a5466a91cd5812d604fa37ad0943b4","https://github.com/pallets/jinja/releases/tag/3.1.5","https://github.com/pallets/jinja/security/advisories/GHSA-q2x7-8rv6-6q7h","https://lists.debian.org/debian-lts-announce/2025/04/msg00022.html"],"description":"Jinja is an extensible templating engine. Prior to 3.1.5, An oversight in how the Jinja sandboxed environment detects calls to str.format allows an attacker that controls the content of a template to execute arbitrary Python code. To exploit the vulnerability, an attacker needs to control the content of a template. Whether that is the case depends on the type of application using Jinja. This vulnerability impacts users of applications which execute untrusted templates. Jinja's sandbox does catch calls to str.format and ensures they don't escape the sandbox. However, it's possible to store a reference to a malicious string's format method, then pass that to a filter that calls it. No such filters are built-in to Jinja, but could be present through custom filters in an application. After the fix, such indirect calls are also handled by the sandbox. This vulnerability is fixed in 3.1.5.","cvss":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","metrics":{"baseScore":7.8,"exploitabilityScore":1.9,"impactScore":5.9},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":5.4},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2024-56326","epss":0.00521,"percentile":0.43191,"date":"2026-09-19"}],"cwes":[{"cve":"CVE-2024-56326","cwe":"CWE-693","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2024-56326","cwe":"CWE-1336","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"jinja2","version":"2.10"}},"found":{"vulnerabilityID":"GHSA-q2x7-8rv6-6q7h","versionConstraint":"<=3.1.4 (python)"},"fix":{"suggestedVersion":"3.1.5"}}],"artifact":{"id":"d51e03b7f2a59975","name":"jinja2","version":"2.10","type":"python","locations":[{"path":"/requirements.txt","accessPath":"/requirements.txt","annotations":{"evidence":"primary"}}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python-jinja2:python-jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python-jinja2:python_jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python_jinja2:python-jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python_jinja2:python_jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:jinja2:python-jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:jinja2:python_jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python-jinja2:jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python:python-jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python:python_jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python_jinja2:jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:jinja2:jinja2:2.10:*:*:*:*:*:*:*","cpe:2.3:a:python:jinja2:2.10:*:*:*:*:*:*:*"],"purl":"pkg:pypi/jinja2@2.10","upstreams":[]}},{"vulnerability":{"id":"GHSA-cpwx-vrp4-4pq7","dataSource":"https://github.com/advisories/GHSA-cpwx-vrp4-4pq7","namespace":"github:language:python","severity":"Medium","urls":["https://github.com/pallets/jinja/security/advisories/GHSA-cpwx-vrp4-4pq7","https://github.com/pallets/jinja/commit/90457bbf33b8662926ae65cdde4c4c32e756e403","https://nvd.nist.gov/vuln/detail/CVE-2025-27516","https://lists.debian.org/debian-lts-announce/2025/04/msg00045.html","https://lists.debian.org/debian-lts-announce/2025/04/msg00022.html"],"description":"Jinja2 vulnerable to sandbox breakout through attr filter selecting format method","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","metrics":{"baseScore":5.4},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-27516","epss":0.00497,"percentile":0.41643,"date":"2026-09-19"}],"cwes":[{"cve":"CVE-2025-27516","cwe":"CWE-1336","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["3.1.6"],"state":"fixed","available":[{"version":"3.1.6","date":"2025-03-06","kind":"first-observed"}]},"advisories":[],"risk":0.25843999999999995},"relatedVulnerabilities":[{"id":"CVE-2025-27516","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-27516","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/pallets/jinja/commit/90457bbf33b8662926ae65cdde4c4c32e756e403","https://github.com/pallets/jinja/security/advisories/GHSA-cpwx-vrp4-4pq7","https://lists.debian.org/debian-lts-announce/2025/04/msg00022.html","https://lists.debian.org/debian-lts-announce/2025/04/msg00045.html"],"description":"Jinja is an extensible templating engine. Prior to 3.1.6, an oversight in how the Jinja sandboxed environment interacts with the |attr filter allows an attacker that controls the content of a template to execute arbitrary Python code. To exploit the vulnerability, an attacker needs to control the content of a template. Whether that is the case depends on the type of application using Jinja. This vulnerability impacts users of applications which execute untrusted templates. Jinja's sandbox does catch calls to str.format and ensures they don't escape the sandbox. However, it's possible to use the |attr filter to get a reference to a string's plain format method, bypassing the sandbox. After the fix, the |attr filter no longer bypasses the environment's attribute lookup. This vulnerability is fixed in 3.1.6.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H","metrics":{"baseScore":8.8,"exploitabilityScore":2.1,"impactScore":6.1},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:P/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":5.4},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-27516","epss":0.00497,"percentile":0.41643,"date":"2026-09-19"}],"cwes":[{"cve":"CVE-2025-27516","cwe":"CWE-1336","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"jinja2","version":"2.10"}},"found":{"vulnerabilityID":"GHSA-cpwx-vrp4-4pq7","versionConstraint":"<=3.1.5 (python)"},"fix":{"suggestedVersion":"3.1.6"}}],"artifact":{"id":