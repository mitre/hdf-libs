  "name": "ubuntu-20-04",
  "requirements": [
    {
      "descriptions": [
        {
          "data": "Temporary passwords for Ubuntu 20.04 operating system logons must\nrequire an immediate change to a permanent password.\n\nVerify that a policy exists that ensures when a user is created, it is\ncreating using a method that forces a user to change their password upon\ntheir next login.",
          "label": "default"
        },
        {
          "data": "ocil:ssg-policy_temp_passwords_immediate_change_ocil:questionnaire:1",
          "label": "check"
        },
        {
          "data": "Without providing this capability, an account may be created without a\npassword. Nonrepudiation cannot be guaranteed once an account is created if\na user is not forced to change the temporary password upon initial logon.\n\nTemporary passwords are typically used to allow access when new accounts\nare created or passwords are changed. It is common practice for\nadministrators to create temporary passwords for user accounts that allow\nthe users to log on, yet force them to change the password once they have\nsuccessfully authenticated.",
          "label": "rationale"
        }
      ],
      "id": "policy_temp_passwords_immediate_change",
      "impact": 0.5,
      "refs": [
        {
          "ref": "CCI-002041",
          "url": "https://public.cyber.mil/stigs/cci/"
        },
        {
          "ref": "SRG-OS-000380-GPOS-00165",
          "url": "https://public.cyber.mil/stigs/downloads/?_dl_facet_stigs=operating-systems%2Cgeneral-purpose-os"
        },
        {
          "ref": "UBTU-20-010440",
          "url": "https://public.cyber.mil/stigs/downloads/?_dl_facet_stigs=operating-systems%2Cunix-linux"
        }
      ],
      "severity": "medium",
      "tags": {
        "check_id": "http://scap.nist.gov/schema/ocil/2",
        "gid": "account_expiration",
        "gtitle": "Set Account Expiration Parameters",
        "nist": [],
        "rid": "policy_temp_passwords_immediate_change",
        "severity": "medium",
        "stig_id": ""
      },
      "title": "Policy Requires Immediate Change of Temporary Passwords"
    },
    {
      "descriptions": [
        {
          "data": "\n              To ensure the default umask for users of the Bash shell is set properly,\nadd or correct the\n              umask\n              setting in\n              /etc/bashrc\n              to read\nas follows:\n              \n                umask\n                \n              \n            ",
          "label": "default"
        },
        {
          "data": "oval:ssg-accounts_umask_etc_bashrc:def:1",
          "label": "check"
        },
        {
          "data": "The umask value influences the permissions assigned to files when they are created.\nA misconfigured umask value could result in files with excessive permissions that can be read or\nwritten to by unauthorized users.",
          "label": "rationale"
        }
      ],
