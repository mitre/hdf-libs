    {
      "descriptions": [
        {
          "data": "dnsmasq is a lightweight tool that provides DNS caching, DNS forwarding and DHCP (Dynamic Host Configuration Protocol) services. The package can be removed with the following command:",
          "label": "default"
        },
        {
          "data": "oval:ssg-package_dnsmasq_removed:def:1",
          "label": "check"
        },
        {
          "data": "Unless a system is specifically designated to act as a DNS caching, DNS forwarding and/or DHCP server, it is recommended that the package be removed to reduce the potential attack surface.",
          "label": "rationale"
        }
      ],
      "id": "xccdf_org.ssgproject.content_rule_package_dnsmasq_removed",
      "impact": 0.3,
      "severity": "low",
