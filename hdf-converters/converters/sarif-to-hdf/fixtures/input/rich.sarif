              }
            }
          ]
        },
        {
          "ruleId": "SEC-003",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Hardcoded token found in configuration."
          },
          "locations": [
            {
              "physicalLocation": {
