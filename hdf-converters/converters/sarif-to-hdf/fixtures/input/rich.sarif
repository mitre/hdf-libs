                }
              }
            }
          ],
          "suppressions": [
            {
              "kind": "inSource",
              "status": "underReview",
              "justification": "Reviewing whether this token is still active"
            },
            {
              "kind": "external",
              "status": "accepted",
              "justification": "Marked as false positive by security team"
            }
          ]
        }
      ]
    }
  ]
}
