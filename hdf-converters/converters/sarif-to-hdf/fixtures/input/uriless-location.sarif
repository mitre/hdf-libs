{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ExampleAnalyzer",
          "version": "1.2.3",
          "rules": [
            {
              "id": "EX001",
              "name": "IndexedArtifact",
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "artifacts": [
        { "location": { "uri": "src/indexed.c" } }
      ],
      "results": [
        {
          "ruleId": "EX001",
          "kind": "fail",
          "level": "warning",
          "message": { "text": "Finding whose artifact is addressed by index." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "index": 0 },
                "region": { "startLine": 42, "startColumn": 9 }
              }
            }
          ]
        }
      ]
    }
  ]
}
