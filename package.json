{
  "name": "hdf-libs",
  "version": "0.1.0",
  "private": true,
  "description": "Heimdall Data Format Libraries - Universal security scan data format",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:go",
    "build:ts": "pnpm -r --filter hdf-schema run build && pnpm -r --filter '!hdf-schema' --filter '!hdf-cli' run build",
    "build:go": "pnpm --filter hdf-cli run build",
    "pretest": "pnpm run build:ts",
    "test": "pnpm run test:ts && pnpm run test:go",
    "test:ts": "pnpm -r run test:ts",
    "test:go": "pnpm -r run test:go",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "clean": "pnpm -r run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.2"
}
