{
  "name": "hdf-libs",
  "version": "0.1.0",
  "private": true,
  "description": "Heimdall Data Format Libraries - Universal security scan data format",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitre/hdf-libs.git"
  },
  "author": "MITRE Corporation",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:go",
    "build:ts": "pnpm -r --filter=!hdf-cli run build",
    "build:go": "pnpm --filter hdf-cli run build",
    "pretest": "pnpm run build:ts",
    "test": "pnpm run test:ts && pnpm run test:go",
    "check": "pnpm run build:ts && pnpm run lint && pnpm run lint:go && pnpm run lint:timestamps && pnpm run typecheck && pnpm run test:coverage && pnpm run security",
    "test:ts": "pnpm -r run test:ts",
    "test:go": "pnpm -r run test:go",
    "test:coverage": "pnpm -r run test:coverage",
    "typecheck": "pnpm -r --filter=!hdf-cli run type-check",
    "security": "pnpm run security:ts && pnpm run security:go",
    "security:ts": "echo '── prod deps (fail on moderate+) ──' && pnpm audit --prod --audit-level=moderate && echo '── dev deps (fail on high+) ──' && pnpm audit --dev --audit-level=high",
    "security:go": "pnpm --filter hdf-cli run security:vuln && pnpm --filter hdf-cli run security:sast",
    "lint": "pnpm -r run lint",
    "lint:go": "pnpm --filter hdf-cli run lint && pnpm --filter @mitre/hdf-converters run lint:go",
    "lint:timestamps": "node scripts/check-timestamp-usage.mjs",
    "lint:fix": "pnpm -r run lint:fix",
    "clean": "pnpm -r run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@types/node": "^25.9.4",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.2",
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-gv7w-rqvm-qjhr",
        "GHSA-fx2h-pf6j-xcff"
      ]
    },
    "overrides": {
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "esbuild@<0.25.0": "0.25.0",
      "shell-quote@<1.8.4": "1.8.4",
      "underscore@<1.13.8": "1.13.8",
      "lodash@>=4.0.0 <4.18.0": "4.18.1",
      "ajv@>=6.0.0 <6.14.0": "6.14.0",
      "ajv@>=8.0.0 <8.18.0": "8.18.0",
      "qs@<6.14.2": "6.14.2",
      "flatted@<3.4.2": "3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "fast-uri@<3.1.2": "3.1.2",
      "fast-xml-builder@<1.1.9": "1.1.9",
      "follow-redirects@<1.16.0": "1.16.0",
      "postcss@<8.5.10": "8.5.10",
      "fflate@0.8.3": "0.8.2"
    }
  }
}
